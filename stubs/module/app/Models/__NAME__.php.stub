<?php

namespace Modules\__NAME__\Models;

use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Modules\__NAME__\Database\Factories\__NAME__Factory;
use OwenIt\Auditing\Auditable;
use OwenIt\Auditing\Contracts\Auditable as AuditableContract;

class __NAME__ extends Model implements AuditableContract
{
    use Auditable, HasFactory;

    protected $table = '__TABLE__';

    protected $fillable = ['name', 'is_active'];

    protected function casts(): array
    {
        return ['is_active' => 'boolean'];
    }

    public function scopeActive(Builder $query): Builder
    {
        return $query->where('is_active', true);
    }

    protected static function newFactory(): __NAME__Factory
    {
        return __NAME__Factory::new();
    }
}
